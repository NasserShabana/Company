@model RoleViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center text-white">Edit of Roles</h1>

<br />

<div class="card mx-auto" style="max-width: 600px;">
    <div class="card-header text-center" style="background-color: #76b852; color: white;">
        
        <strong> @Model.RoleName </strong>
    </div>
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <partial name="PartialViews/EditCreatePartialView" model="Model" />
            <div class="text-center">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-light ml-2">Back To List</a>
            </div>
        </form>
    </div>
</div>

<br />

<div class="text-center">
    <a asp-action="AddOrRemoveUser" asp-route-roleId="@Model.Id" class="btn btn-danger" style="margin-left:5px; padding:10px 15px;">Add Or Remove Users</a>
</div>

@section CSV {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

<style>
    h1 {
        margin-bottom: 20px; /* Space below the title */
    }

    .card {
        border-radius: 10px; /* Rounded corners */
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Shadow for depth */
    }

    .btn {
        transition: background-color 0.3s, transform 0.2s; /* Smooth transitions for buttons */
    }

        .btn:hover {
            transform: scale(1.05); /* Slightly scale up on hover */
        }

    .btn-light {
        color: #343a40; /* Dark text on light background */
    }
</style>
