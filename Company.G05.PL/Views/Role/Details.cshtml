@model RoleViewModel
@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center text-white">Details Of Roles</h1>

<br />

<div class="card mx-auto" style="max-width: 400px;">
    <div class="card-header text-center" style="background-color: #76b852; color: white;">
        Role Information
    </div>
    <div class="card-body">
        <partial name="PartialViews/DeleteDetailsRolePartialView" model="Model" />
        <br />
        <div class="text-center">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-light ml-2">Back To List</a>
        </div>
    </div>
</div>
<br />
<style>
    h1 {
        margin-bottom: 20px; /* Space below the title */
    }

    .card {
        border-radius: 10px; /* Rounded corners */
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Shadow for depth */
    }

    .btn {
        transition: background-color 0.3s, transform 0.2s; /* Smooth transitions for buttons */
    }

        .btn:hover {
            transform: scale(1.05); /* Slightly scale up on hover */
        }

    .btn-light {
        color: #343a40; /* Dark text on light background */
    }
</style>
